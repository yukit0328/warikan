    catch { prompt('このURLをコピーしてください', location.href); }
  };
}

// ----- ほかの人による変更のお知らせ -----
// 前に「確認した」ときの支払いの中身をこのスマホに覚えておき、今の中身と比べる
const seenKey = () => 'warikan-seen-' + key;
const sigOf = e => JSON.stringify([e.title, e.amount, e.payer, [...e.participants].sort(), e.date, !!e.hasReceipt]);
const fmtTime = t => { const v = tsNum(t); if (!v) return ''; const d = new Date(v); return ` ${d.getMonth() + 1}/${d.getDate()} ${d.getHours()}:${String(d.getMinutes()).padStart(2, '0')}`; };
let seen = null, changes = [], dataLoaded = false;
function seenLoad() { try { const o = JSON.parse(lsGet(seenKey())); return o && o.items ? o : null; } catch { return null; } }
function seenSaveNow() {
  const items = {};
  for (const e of expenses) items[e.id] = { sig: sigOf(e), title: e.title, amount: e.amount };
  seen = { at: Date.now(), items }; lsSet(seenKey(), JSON.stringify(seen));
}
function seenForget(id) { if (seen?.items[id]) { delete seen.items[id]; lsSet(seenKey(), JSON.stringify(seen)); } }
function computeChanges() {
  if (!dataLoaded) return;
  if (!seen) seen = seenLoad();
  if (!seen) { seenSaveNow(); changes = []; return; }   // 初めて開いたときは今の状態を覚えるだけ
  const me = lsGet(meKey()), out = [], ids = new Set();
  let dirty = false;
  for (const e of expenses) {
    ids.add(e.id);
    const old = seen.items[e.id], sig = sigOf(e), by = e.updatedBy || e.createdBy || '';
    if (old && old.sig === sig) continue;
    if (me && by === me) { seen.items[e.id] = { sig, title: e.title, amount: e.amount }; dirty = true; continue; }   // 自分の変更はお知らせしない
    out.push(old ? { kind: 'edit', id: e.id, e, old, by } : { kind: 'add', id: e.id, e, by });
  }
  for (const [id, old] of Object.entries(seen.items)) if (!ids.has(id)) out.push({ kind: 'del', id, old });
  if (dirty) lsSet(seenKey(), JSON.stringify(seen));
  changes = out;
}
const changeOf = id => changes.find(c => c.id === id && c.kind !== 'del');
function renderChanges() {
  const box = $('changesBox');
  box.classList.toggle('hidden', !changes.length);
  if (!changes.length) { box.innerHTML = ''; return; }
  const who = c => c.by ? `（${esc(nameOf(c.by))}）` : '';
  const li = c => c.kind === 'add' ? `<li>追加：${esc(c.e.title)} ${yen(c.e.amount)}${who(c)}</li>`
    : c.kind === 'edit' ? `<li>修正：${esc(c.e.title)} ${yen(c.e.amount)}${c.old.amount !== c.e.amount ? `（前は ${yen(c.old.amount)}）` : ''}${who(c)}</li>`
    : `<li>削除：${esc(c.old.title)} ${yen(c.old.amount)}</li>`;
  box.innerHTML = `<div class="ch-h">前に確認したあと、ほかの人の変更が${changes.length}件あります</div><ul>${changes.map(li).join('')}</ul>
    <button type="button" class="small" id="changesOk" style="margin-top:8px">確認した</button>`;
  $('changesOk').onclick = () => { seenSaveNow(); changes = []; render(); };
}

// ----- 旅行名・状態 -----
let tripMeta = null;
function renderMeta() {
  const m = tripMeta;
  $('tripName').classList.toggle('hidden', !m);
  if (!m) return;
  const settled = m.status === 'settled';
  $('tripTitle').textContent = m.name || '名前なし';
