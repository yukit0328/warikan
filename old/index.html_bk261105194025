  $('tripBadge').className = 'badge ' + (settled ? 'settled' : 'active');
  $('settleBtn').textContent = settled ? '精算中に戻す' : '精算完了にする';
  $('settleBtn').className = (settled ? 'sub ' : '') + 'wide';
  document.title = (m.name ? m.name + '｜' : '') + '割り勘・精算';
  histTouch(key, { name: m.name || '名前なし', status: m.status || 'active' });
}

// ----- このスマホで開いた割り勘の一覧（このブラウザの中だけ）-----
const HK = 'warikan-history';
function histLoad() { try { const a = JSON.parse(lsGet(HK)); return Array.isArray(a) ? a : []; } catch { return []; } }
function histSave(a) { lsSet(HK, JSON.stringify(a.slice(0, 50))); }
function histTouch(k, d) {
  const a = histLoad(), i = a.findIndex(x => x.k === k);
  const cur = i >= 0 ? a.splice(i, 1)[0] : { k, name: '名前なし', status: 'active' };
  a.unshift({ ...cur, ...d, at: Date.now() }); histSave(a);
}
function histRemove(k) { histSave(histLoad().filter(x => x.k !== k)); }
function renderHistory() {
  const a = histLoad();
  $('histSec').classList.toggle('hidden', !a.length);
  $('histBody').innerHTML = a.map(x => {
    const settled = x.status === 'settled', d = new Date(x.at || 0);
    return `<div class="hist"><div><a href="./#k=${esc(x.k)}">${esc(x.name || '名前なし')}</a> <span class="badge ${settled ? 'settled' : 'active'}">${settled ? '精算完了' : '精算中'}</span>
      <div class="meta">最後に開いた日 ${d.getMonth() + 1}/${d.getDate()}</div></div>
      <button type="button" class="danger small" data-unhist="${esc(x.k)}">一覧から外す</button></div>`;
  }).join('');
  $('histBody').querySelectorAll('[data-unhist]').forEach(b => b.onclick = () => { histRemove(b.dataset.unhist); renderHistory(); });
}

// メンバーを追加して、追加したメンバーのIDを返す（やめたときは null）。onId は保存完了を待たずに呼ぶ
async function addMemberFlow(name, onId) {
    if (!name) return null;
    if (members.some(m => m.name === name)) { alert('同じ名前のメンバーがいます'); return null; }
    const order = members.reduce((mx, m) => Math.max(mx, m.order ?? 0), 0) + 1;
    const allExp = expenses.filter(isAll);
    if (allExp.length) {
      const ans = await askInclude(name, allExp);
      if (ans === 'cancel') return null;
      if (ans === 'no') {
        // これまでの「全員の分」を、今いるメンバーだけの支払いに切り替える
        const ids = members.map(m => m.id);
        for (const e of allExp) if (!(await run(store.updateExpense(e.id, { participants: ids })))) return null;
      }
    }
    try { const { id, done } = store.addMember(name, order); if (onId) onId(id); await done; toast(`${name} さんを追加しました`); return id; }
    catch (err) { console.error(err); alert('保存できませんでした。通信状態を確認して、もう一度お試しください。'); return null; }
}

async function start() {
  key = getKey();
  if (!key) {
    $('noKey').classList.remove('hidden'); $('nav').classList.add('hidden');
    $('newKeyBtn').onclick = () => {
      const k = newKey();
      lsSet('warikan-newname-' + k, $('newName').value.trim().slice(0, 40));
      location.hash = 'k=' + k; location.reload();
    };
    renderHistory();
    return;
  }
  $('app').classList.remove('hidden'); $('fab').classList.remove('hidden');
  $('shareUrl').textContent = location.href;
  bindForms();
  if (firebaseConfig) {
    try { store = await firestoreStore(key); }
    catch (err) { console.error(err); $('modeBanner').innerHTML = '<div class="banner alert">データベースに接続できませんでした。通信状態を確認して、ページを開き直してください。</div>'; return; }
  } else {
    store = localStore(key);
    $('modeBanner').innerHTML = '<div class="banner warn"><b>お試しモード</b>：データベースが未設定のため、入力はこのブラウザの中だけに保存されます。ほかの人には見えません。</div>';
  }
  histTouch(key, {});
  let metaTried = false;
  store.subscribeMeta(m => {
    if (!m && !metaTried) {
      // 旅行名と状態がまだない割り勘（新規・以前に作ったもの）には作っておく
      metaTried = true;
      const nk = 'warikan-newname-' + key;
      store.createMeta(lsGet(nk) || '名前なし').then(() => { try { localStorage.removeItem(nk); } catch {} }).catch(err => console.warn('meta', err?.code));
      return;
    }
    tripMeta = m; renderMeta();
  });
  store.subscribe((m, e) => { members = m; expenses = e; dataLoaded = true; render(); },
    err => { console.error(err); $('modeBanner').innerHTML = `<div class="banner alert">データを読み込めませんでした（${esc(err?.code || '')}）。URLが正しいか確認してください。</div>`; });
}
// 下のナビはURLの合言葉（#k=…）を消さないよう、URLを変えずにスクロールする
document.querySelectorAll('[data-go]').forEach(a => a.onclick = ev => { ev.preventDefault(); $(a.dataset.go).scrollIntoView(); });
// 合言葉が変わったときだけ開き直す
window.addEventListener('hashchange', () => { if (getKey() !== key) location.reload(); });
start();
