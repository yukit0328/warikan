async function run(p, okMsg) {
  try { await p; if (okMsg) toast(okMsg); return true; }
  catch (err) { console.error(err); alert('保存できませんでした。通信状態を確認して、もう一度お試しください。\n' + (err?.code || err?.message || '')); return false; }
}

// ----- レシートの読み取り（スマホの中で文字認識。最初の1回だけ認識用データ約5MBを読み込む）-----
const TESS = { js: 'https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js', worker: 'https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/worker.min.js', core: 'https://cdn.jsdelivr.net/npm/tesseract.js-core@5.1.1', lang: 'https://cdn.jsdelivr.net/npm/@tesseract.js-data/jpn@1.0.0/4.0.0_best_int' };
let ocrWorker = null;
function loadScript(src) { return new Promise((ok, ng) => { const el = document.createElement('script'); el.src = src; el.onload = ok; el.onerror = ng; document.head.appendChild(el); }); }
async function getOcrWorker(onProgress) {
  if (ocrWorker) return ocrWorker;
  if (!window.Tesseract) await loadScript(TESS.js);
  ocrWorker = await Tesseract.createWorker('jpn', 1, { workerPath: TESS.worker, corePath: TESS.core, langPath: TESS.lang, logger: m => onProgress(m) });
  return ocrWorker;
}
// 写真を縮小・白黒にして読み取りやすくする
async function prepImage(file) {
  const bmp = await createImageBitmap(file);
  const k = Math.min(1, 1800 / Math.max(bmp.width, bmp.height));
  const c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
  const g = c.getContext('2d'); g.drawImage(bmp, 0, 0, c.width, c.height);
  const d = g.getImageData(0, 0, c.width, c.height), px = d.data;
  for (let i = 0; i < px.length; i += 4) { const y = px[i] * .299 + px[i + 1] * .587 + px[i + 2] * .114; const v = Math.max(0, Math.min(255, (y - 128) * 1.4 + 128)); px[i] = px[i + 1] = px[i + 2] = v; }
  g.putImageData(d, 0, 0);
  return c;
}
// 読み取った文字から「合計」らしい金額を候補として拾う
function amountCandidates(text) {
  const found = new Map();
  for (let line of text.split(/\n/)) {
    line = line.normalize('NFKC').replace(/\s+/g, ' ');
    const kw = line.replace(/\s/g, '');
    if (/(預|玉り|現金|釣|おつり|ポイント|TEL|電話|レジ|No\.|番号|登録|カード)/i.test(kw)) continue;
    if (/\d{1,4}[\/年.-]\d{1,2}[\/月.-]\d{1,2}|\d{1,2}:\d{2}/.test(line)) continue;
    const flat = line.replace(/(\d)[ ,.]{1,2}(?=\d{3}(?!\d))/g, '$1');
    let score = 0;
    if (/(合計|お会計|ご請求|お支払|総額|TOTAL)/i.test(kw) && !/小計/.test(kw)) score = 3;
    else if (/小計/.test(kw)) score = 1;
    else if (/(税|対象|内訳|点)/.test(kw)) continue;
    if (/[¥\\円]/.test(line)) score += 1;
    for (const m of flat.matchAll(/(\d{1,7})(?!\d)/g)) {
      const v = parseInt(m[1], 10);
      if (v < 10 || v > 10000000) continue;
      found.set(v, Math.max(found.get(v) ?? -1, score));
    }
  }
  return [...found.entries()].sort((a, b) => b[1] - a[1] || b[0] - a[0]).slice(0, 5).map(([v, sc]) => ({ v, sc }));
}
async function readReceipt(file) {
  const box = $('ocrBox');
  box.classList.remove('hidden'); box.textContent = 'レシートを読み取っています…';
  try {
    const w = await getOcrWorker(m => { if (m.status === 'recognizing text') box.textContent = `読み取り中… ${Math.round(m.progress * 100)}%`; else if (/load/.test(m.status)) box.textContent = '読み取りの準備中…（初回だけ少し時間がかかります）'; });
    const { data } = await w.recognize(await prepImage(file));
    window._ocrText = data.text;
    const cands = amountCandidates(data.text);
    if (!cands.length) { box.textContent = '金額を読み取れませんでした。手で入力してください。'; return; }
    if (cands[0].sc >= 3 && !$('fAmount').value) { $('fAmount').value = cands[0].v; updatePerHead(); }
    box.innerHTML = `<div>${cands[0].sc >= 3 ? '「合計」の金額を入れました。違うときは候補をタップ：' : '金額の候補（タップで入力）：'}</div><div class="cands">${cands.map(c => `<button type="button" data-v="${c.v}">${yen(c.v)}</button>`).join('')}</div>`;
    box.querySelectorAll('[data-v]').forEach(b => b.onclick = () => { $('fAmount').value = b.dataset.v; updatePerHead(); });
  } catch (err) {
    console.error(err);
    box.textContent = '読み取りに失敗しました。通信状態を確認するか、手で入力してください。';
  }
}

