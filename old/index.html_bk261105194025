// 写真を保存用に縮小（データベースの1件あたりの上限に収まるよう、大きければ画質を下げて再圧縮）
async function compressPhoto(file) {
  const bmp = await createImageBitmap(file);
  for (const [side, q] of [[1280, .6], [1024, .5], [800, .45]]) {
    const k = Math.min(1, side / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
    c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
    const url = c.toDataURL('image/jpeg', q);
    if (url.length < 850000) return url;
  }
  return null;
}
let pendingPhoto = null;
async function zipReceipts() {
  const list = await store.allReceipts();
  if (!list.length) { alert('保存されているレシート写真はありません。'); return false; }
  if (!window.JSZip) await loadScript('https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js');
  const zip = new JSZip();
  for (const r of list) {
    const e = expenses.find(x => x.id === r.id);
    zip.file(e ? fileName(e) : `${r.id}.jpg`, r.data.split(',')[1], { base64: true });
  }
  const blob = await zip.generateAsync({ type: 'blob' });
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `receipts_${today()}.zip`;
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 10000);
  toast(`${list.length}枚をダウンロードしました`);
  return true;
}

function renderResult() {
  if (!members.length || !expenses.length) { $('resultBody').innerHTML = '<p class="empty">支払いを入力すると、ここに精算結果が出ます。</p>'; return; }
  const { bal, transfers } = settle(members, expenses);
  const total = expenses.reduce((s, e) => s + e.amount, 0);
  const me = lsGet(meKey()), meOk = members.some(m => m.id === me);
  const n = id => esc(nameOf(id)) + ' さん';

  // あなたの精算（「あなたは誰？」を選んでいるとき）
  let mine = '';
  if (meOk) {
    const pay = transfers.filter(t => t.from === me), get = transfers.filter(t => t.to === me);
    const lines = [
      ...pay.map(t => `<div class="transfer"><span>${n(t.to)}に <b>払う</b></span><b class="minus">${yen(t.amount)}</b></div>`),
      ...get.map(t => `<div class="transfer"><span>${n(t.from)}から <b>受け取る</b></span><b class="plus">${yen(t.amount)}</b></div>`),
    ];
    mine = `<div class="mine"><div class="mine-h">${esc(nameOf(me))} さんの精算</div>${lines.length ? lines.join('') : '<p class="empty" style="margin:6px 0 0">払う・受け取るお金はありません。</p>'}</div>`;
  }

  // 全員の送金
  const all = transfers.length
    ? transfers.map(t => `<div class="transfer"><span>${n(t.from)} → ${n(t.to)}</span><b>${yen(t.amount)}</b></div>`).join('')
    : '<p class="empty" style="margin-top:8px">精算は不要です。</p>';

  // 一人ずつの内訳
  const detail = members.map(m => {
    const b = bal[m.id], d = b.paid - b.owe;
    const res = d > 0 ? `<span class="plus">${yen(d)} 受け取る</span>` : d < 0 ? `<span class="minus">${yen(-d)} 払う</span>` : '精算なし';
    return `<div class="person"><div class="person-h"><b>${esc(m.name)}</b>${res}</div>
      <div class="exp-meta">立て替えた額 ${yen(b.paid)} − 自分が使った分 ${yen(b.owe)} ＝ ${d >= 0 ? '+' : ''}${yen(d)}</div></div>`;
  }).join('');

  $('resultBody').innerHTML = `${mine}
    <h3 class="rh">全員の精算（このとおりにお金を渡せば完了）</h3>
    ${all}
    <h3 class="rh">計算の内訳</h3>
    <p class="note" style="margin-top:0">合計 ${yen(total)}（${expenses.length}件）。自分が立て替えた額から、自分が使った分を引いた差を精算します。プラスの人は受け取り、マイナスの人は払います。</p>
    ${detail}
    <p class="note">割り切れない端数は、メンバー順で先の人が1円ずつ多く負担します。</p>`;
}

