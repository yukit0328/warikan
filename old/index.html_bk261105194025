<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<title>割り勘・精算</title>
<style>
:root{--ink:#17212b;--muted:#5b6875;--line:#d9e0e6;--bg:#f3f6f8;--paper:#fff;--accent:#245a73;--soft:#eaf2f5;--warn-bg:#fff8e8;--warn:#c48a1a;--alert-bg:#fff0ee;--alert:#bd5146;--ok-bg:#ecf7f1;--ok:#1c7c54}
*{box-sizing:border-box}
html{scroll-padding-top:12px;scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Noto Sans JP","Yu Gothic",Meiryo,sans-serif;line-height:1.6;-webkit-text-size-adjust:100%}
main{max-width:720px;margin:auto;padding:24px max(16px,env(safe-area-inset-left)) 96px max(16px,env(safe-area-inset-right))}
h1{font-size:24px;margin:0 0 2px}
.lead{color:var(--muted);margin:0 0 16px;font-size:13px}
.lead a{color:var(--accent)}
section{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:16px;margin:0 0 14px}
h2{font-size:16px;color:var(--accent);margin:0 0 10px;letter-spacing:.03em}
.note{font-size:13px;color:var(--muted);margin:6px 0 0}
.banner{border-radius:12px;padding:12px 14px;font-size:14px;margin:0 0 14px}
.banner.warn{background:var(--warn-bg);border:1px solid #f0d9a6}
.banner.alert{background:var(--alert-bg);border:1px solid #f0c5bf}
.banner.ok{background:var(--ok-bg);border:1px solid #bfe3cf}
label{display:block;font-size:13px;font-weight:700;margin:10px 0 4px}
input[type=text],input[type=number],input[type=date],select{width:100%;font:inherit;font-size:16px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}
input:focus,select:focus{outline:2px solid var(--accent);outline-offset:1px}
.row{display:flex;gap:8px;align-items:flex-end}
.row>*{flex:1}
.row>.shrink{flex:0 0 auto}
button{font:inherit;font-size:15px;font-weight:700;border-radius:10px;padding:10px 14px;border:1px solid var(--accent);background:var(--accent);color:#fff;cursor:pointer}
button.sub{background:#fff;color:var(--accent)}
button.danger{background:#fff;color:var(--alert);border-color:#e3b3ad}
button.small{font-size:13px;padding:6px 10px}
button:disabled{opacity:.5;cursor:default}
.wide{width:100%;margin-top:14px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:6px 8px 6px 12px;background:var(--soft);font-size:14px}
.chip button{padding:0 6px;font-size:13px;border:none;background:none;color:var(--muted)}
.checks{display:flex;flex-wrap:wrap;gap:8px}
.checks label{display:inline-flex;align-items:center;gap:6px;margin:0;font-weight:400;font-size:15px;border:1px solid var(--line);border-radius:10px;padding:8px 12px;background:#fff}
.checks input{width:18px;height:18px;margin:0;accent-color:var(--accent)}
.linkbtn{background:none;border:none;color:var(--accent);padding:0;font-size:13px;font-weight:700;text-decoration:underline}
.exp{border-top:1px solid var(--line);padding:12px 0}
.exp:first-child{border-top:none;padding-top:0}
.exp-head{display:flex;justify-content:space-between;gap:8px;align-items:baseline}
.exp-title{font-weight:800;font-size:16px;word-break:break-word}
.exp-amount{font-weight:800;font-size:17px;white-space:nowrap}
.exp-meta{font-size:13px;color:var(--muted)}
.exp-actions{display:flex;gap:8px;margin-top:6px}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{padding:8px 6px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
th:first-child,td:first-child{text-align:left;white-space:normal}
th{font-size:12px;color:var(--muted);font-weight:700}
.plus{color:var(--ok);font-weight:800}
.minus{color:var(--alert);font-weight:800}
.transfer{display:flex;justify-content:space-between;align-items:center;gap:8px;background:var(--soft);border-radius:10px;padding:10px 12px;margin-top:8px;font-size:15px}
.transfer b{font-size:16px}
.mine{border:2px solid var(--accent);border-radius:12px;padding:12px;margin-bottom:4px}
.mine-h{font-weight:800;font-size:16px}
.mine .transfer{background:#fff;border:1px solid var(--line)}
.rh{font-size:15px;margin:18px 0 6px;color:var(--ink)}
.person{border-top:1px solid var(--line);padding:8px 0}
.person-h{display:flex;justify-content:space-between;gap:8px;font-size:15px}
.empty{color:var(--muted);font-size:14px;margin:0}
.urlbox{font-family:ui-monospace,Menlo,monospace;font-size:12px;word-break:break-all;background:var(--soft);border-radius:8px;padding:8px 10px;margin:6px 0}
.hidden{display:none!important}
nav.bottom{position:fixed;left:0;right:0;bottom:0;background:rgba(255,255,255,.96);border-top:1px solid var(--line);display:flex;justify-content:center;padding:6px max(8px,env(safe-area-inset-left)) calc(6px + env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-right));z-index:10}
nav.bottom a{flex:1;max-width:140px;text-align:center;font-size:12px;font-weight:700;color:var(--accent);text-decoration:none;padding:6px 2px;border-radius:8px}
nav.bottom a:active{background:var(--soft)}
.toast{position:fixed;left:50%;bottom:72px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:8px 14px;border-radius:999px;font-size:14px;opacity:0;transition:opacity .2s;pointer-events:none;z-index:20}
.toast.show{opacity:.92}
.camview{position:fixed;inset:0;background:#000;z-index:50;display:flex;flex-direction:column}
.camview video{flex:1;width:100%;min-height:0;object-fit:contain;background:#000}
.cambar{display:flex;justify-content:space-between;align-items:center;padding:16px 20px calc(16px + env(safe-area-inset-bottom))}
.shutter{width:72px;height:72px;border-radius:50%;background:#fff;border:6px solid #9aa;padding:0}
.btnlike{display:inline-flex;align-items:center;justify-content:center;margin:0;font-size:15px;font-weight:700;border-radius:10px;padding:10px 14px;border:1px solid var(--accent);background:#fff;color:var(--accent);cursor:pointer;-webkit-user-select:none;user-select:none}
.visually-hidden{position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;pointer-events:none}
.photo{display:flex;align-items:center;gap:10px;margin-top:8px}
.photo img{width:56px;height:72px;object-fit:cover;border-radius:6px;border:1px solid var(--line)}
.photo label{display:flex;align-items:center;gap:6px;margin:0;font-weight:400;font-size:14px}
#viewerBody img{width:100%;border-radius:8px;border:1px solid var(--line)}
#viewer{z-index:35}
#askAdd{z-index:40}
.mebar{display:flex;justify-content:space-between;align-items:center;gap:8px;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:8px 14px;margin:0 0 14px;font-size:14px}
.mebar b{font-size:16px}
#whoChips button{font-size:16px;padding:10px 16px}
.fab{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:calc(64px + env(safe-area-inset-bottom));z-index:15;border-radius:999px;padding:14px 20px;font-size:16px;box-shadow:0 6px 18px rgba(23,33,43,.25)}
.overlay.sheet{align-items:flex-end;padding:0}
.sheet-body{background:#fff;border-radius:18px 18px 0 0;width:100%;max-width:720px;max-height:92vh;overflow:auto;margin:0;border:none;padding:16px 16px calc(20px + env(safe-area-inset-bottom))}
.sheet-head{display:flex;justify-content:space-between;align-items:center}
.sheet-head h2{margin:0}
input.big{font-size:24px;font-weight:800;padding:10px 12px}
.quick{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.quick button,.ocr button{font-size:13px;font-weight:700;padding:6px 10px;border-radius:999px;background:var(--soft);color:var(--accent);border:1px solid var(--line)}
.summary{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:12px;background:var(--soft);border-radius:10px;padding:8px 12px;font-size:13px}
.ocr{margin-top:8px;background:var(--warn-bg);border:1px solid #f0d9a6;border-radius:10px;padding:8px 10px;font-size:13px}
.ocr .cands{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
body.locked{overflow:hidden}
.checks label.all-chip{border-color:var(--accent);font-weight:700;color:var(--accent)}
.all-on #fParts label{opacity:.45}
label.fixed{display:flex;align-items:flex-start;gap:8px;font-weight:400;font-size:14px;background:var(--warn-bg);border:1px solid #f0d9a6;border-radius:10px;padding:10px 12px;margin-top:10px}
label.fixed input{width:18px;height:18px;margin:2px 0 0;flex:0 0 auto;accent-color:var(--accent)}
.overlay{position:fixed;inset:0;background:rgba(23,33,43,.45);display:flex;align-items:center;justify-content:center;padding:16px;z-index:30}
.dialog{background:#fff;border-radius:14px;padding:18px;max-width:420px;width:100%;max-height:85vh;overflow:auto}
.dialog-h{font-weight:800;font-size:17px}
.dialog-list{font-size:14px;margin:10px 0 0;background:var(--soft);border-radius:10px;padding:8px 12px}
.tripname{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 4px}
.tripname b{font-size:17px}
.badge{display:inline-block;font-size:12px;font-weight:700;border-radius:999px;padding:1px 10px}
.badge.active{background:var(--soft);color:var(--accent);border:1px solid var(--line)}
.badge.settled{background:var(--ok-bg);color:var(--ok);border:1px solid #bfe3cf}
.hist{display:flex;justify-content:space-between;align-items:center;gap:8px;border-top:1px solid var(--line);padding:10px 0}
.hist:first-child{border-top:none}
.hist a{font-weight:800;color:var(--ink);text-decoration:none;font-size:16px;word-break:break-word}
.hist .meta{font-size:12px;color:var(--muted)}
.changes{background:var(--warn-bg);border:1px solid #f0d9a6;border-radius:12px;padding:12px 14px;margin:0 0 14px;font-size:14px}
.changes .ch-h{font-weight:800;font-size:15px}
.changes ul{margin:6px 0 0;padding-left:18px}
.changes li{margin:2px 0}
.exp.changed{background:var(--warn-bg);border-radius:10px;padding:10px;margin:4px -10px}
.newtag{display:inline-block;font-size:11px;font-weight:700;color:#fff;background:var(--warn);border-radius:6px;padding:0 6px;margin-right:6px;vertical-align:2px}
.tag{display:inline-block;font-size:11px;font-weight:700;color:var(--warn);border:1px solid #f0d9a6;background:var(--warn-bg);border-radius:6px;padding:0 6px;margin-left:4px;vertical-align:1px}
</style>
</head>
<body>
<main>
<h1>割り勘・精算</h1>
<p class="lead">旅行中の立て替えを記録して、最後に誰が誰にいくら払うかを計算します。</p>

<div class="tripname hidden" id="tripName"><b id="tripTitle"></b><span class="badge" id="tripBadge"></span><button type="button" class="linkbtn" id="renameBtn">名前を変える</button></div>
<div id="modeBanner"></div>

<!-- 合言葉がないとき -->
<section id="noKey" class="hidden">
  <h2>この旅行の精算ページを作る</h2>
  <p class="note" style="margin-top:0">URLの合言葉で旅行ごとのデータを分けています。共有されたURLから開いた場合は、URLが途中で切れていないか確認してください。</p>
  <label for="newName">旅行の名前</label>
  <input type="text" id="newName" maxlength="40" placeholder="例：2026年11月 福岡">
  <button id="newKeyBtn" class="wide">新しい精算ページを作る</button>
</section>
<section id="histSec" class="hidden">
  <h2>このスマホで開いた割り勘</h2>
  <div id="histBody"></div>
  <p class="note">このスマホで作った・開いたことのある割り勘だけが出ます。「一覧から外す」はこのスマホの一覧から消すだけで、データは消えません。</p>
</section>

<div id="app" class="hidden">
  <!-- 入力者（2回目以降はこの1行だけ） -->
  <div class="mebar" id="meBar"><span id="meName"></span><button type="button" class="linkbtn" id="meChange">変更</button></div>

  <!-- 精算結果 -->
  <!-- ほかの人による変更のお知らせ -->
  <div class="changes hidden" id="changesBox"></div>

  <section id="resultSec">
    <h2>精算結果</h2>
    <div id="resultBody"></div>
  </section>

  <!-- 一覧 -->
  <section id="listSec">
    <h2>支払いの一覧</h2>
    <div id="listBody"></div>
  </section>

  <!-- メンバー -->
  <section id="memberSec">
    <h2>メンバー</h2>
    <div class="chips" id="memberChips"></div>
    <form id="memberForm" class="row" style="margin-top:12px" autocomplete="off">
      <div><input type="text" id="mName" maxlength="20" placeholder="名前（20文字まで）" required></div>
      <button type="submit" class="shrink">追加</button>
    </form>
    <p class="note">支払いに使われているメンバーは削除できません。</p>
  </section>

  <!-- 精算が終わったら -->
  <section id="endSec">
    <h2>精算が終わったら</h2>
    <p class="note" style="margin-top:0">お金のやりとりが終わったら「精算完了にする」を押してください。レシート写真が必要な人は、先にまとめてダウンロードしておいてください。</p>
    <button class="wide" id="settleBtn">精算完了にする</button>
    <button class="sub wide" id="zipBtn" style="margin-top:8px">レシート写真をまとめてダウンロード（ZIP）</button>
    <p class="note"><a href="./" style="color:var(--accent)">ほかの割り勘を見る・新しく作る</a></p>
  </section>

  <!-- 共有 -->
  <section id="shareSec">
    <h2>このページを共有する</h2>
    <p class="note" style="margin-top:0">このURLを知っている人は誰でも見たり書き込んだりできます。旅行メンバー以外には送らないでください。</p>
    <div class="urlbox" id="shareUrl"></div>
    <button class="sub" id="copyBtn">URLをコピー</button>
  </section>
</div>
<p class="note" style="text-align:center">版 2026-11-05h</p>
</main>

<nav class="bottom" id="nav">
  <a href="#" data-go="resultSec">精算結果</a>
  <a href="#" id="navAdd">＋入力</a>
  <a href="#" data-go="listSec">一覧</a>
  <a href="#" data-go="memberSec">メンバー</a>
</nav>
<!-- 支払いの入力（＋ボタンから下に開く） -->
<div class="overlay sheet hidden" id="sheet">
  <section class="sheet-body" id="formSec">
    <div class="sheet-head"><h2 id="formTitle">支払いを追加</h2><button type="button" class="linkbtn" id="sheetClose">閉じる</button></div>
    <form id="expForm" autocomplete="off">
      <label for="fAmount">金額（円）</label>
      <input type="number" id="fAmount" class="big" inputmode="numeric" min="1" max="10000000" step="1" placeholder="3000" required>
      <div class="row" style="margin-top:8px">
        <button type="button" class="btnlike" id="camBtn">📷 レシートを撮る</button>
        <label for="picInput" class="btnlike" id="picBtn">🖼 写真から選ぶ</label>
      </div>
      <input type="file" id="camInput" accept="image/*" capture="environment" class="visually-hidden">
      <input type="file" id="picInput" accept="image/*" class="visually-hidden">
      <div id="ocrBox" class="ocr hidden"></div>
      <div id="photoBox" class="photo hidden"><img id="photoThumb" alt="レシート写真"><label><input type="checkbox" id="fKeepPhoto" checked>この写真を保存する</label></div>
      <label for="fTitle">内容</label>
      <input type="text" id="fTitle" maxlength="50" placeholder="例：昼食、ガソリン、駐車場">
      <div class="quick" id="titleChips"></div>
      <div class="summary"><span id="sumText"></span><button type="button" class="linkbtn" id="detailBtn">変更</button></div>
      <div id="details" class="hidden">
        <div class="row">
          <div>
            <label for="fPayer">払った人</label>
            <select id="fPayer" required></select>
          </div>
          <div>
            <label for="fDate">日付</label>
            <input type="date" id="fDate" required>
          </div>
        </div>
        <label>誰の分か <button type="button" class="linkbtn" id="allBtn">今いるメンバーを全員選択</button></label>
        <div class="checks" id="partsBox"><label class="all-chip"><input type="checkbox" id="fAll" checked>全員</label><span id="fParts" style="display:contents"></span></div>
        <p class="note" id="allNote"></p>
      </div>
      <p class="note" id="perHead"></p>
      <div class="row" style="margin-top:12px">
        <button type="submit" id="saveBtn">追加する</button>
        <button type="button" class="sub shrink hidden" id="cancelEdit">やめる</button>
      </div>
    </form>
  </section>
</div>
<button type="button" class="fab hidden" id="fab">＋ 支払いを追加</button>
<div class="overlay hidden" id="whoModal">
  <div class="dialog">
    <div class="dialog-h">あなたは誰？</div>
    <p class="note" style="margin:6px 0 0">選んだ名前はこのスマホに記憶され、支払いを入れるときの「払った人」になります。次からは聞かれません。</p>
    <div class="chips" id="whoChips" style="margin-top:12px"></div>
    <label for="whoName" id="whoNameLabel">リストにないときは、名前を入力</label>
    <form class="row" id="whoForm" autocomplete="off">
      <div><input type="text" id="whoName" maxlength="20" placeholder="名前（20文字まで）"></div>
      <button type="submit" class="shrink">これが自分</button>
    </form>
    <button type="button" class="linkbtn" id="whoSkip" style="display:block;margin:14px auto 0">あとで（見るだけ）</button>
  </div>
</div>
<div class="overlay hidden" id="viewer">
  <div class="dialog">
    <div class="dialog-h" id="viewerTitle"></div>
    <div id="viewerBody" style="margin-top:10px"></div>
    <a class="hidden" id="viewerDl" download><button type="button" class="wide">この写真をダウンロード</button></a>
    <button type="button" class="linkbtn" id="viewerClose" style="display:block;margin:12px auto 0">閉じる</button>
  </div>
</div>
<div class="camview hidden" id="camView">
  <video id="camVideo" playsinline autoplay muted></video>
  <div class="cambar">
    <button type="button" class="sub" id="camCancel">やめる</button>
    <button type="button" class="shutter" id="camShot" aria-label="撮影"></button>
    <span style="width:72px"></span>
  </div>
</div>
<div class="toast" id="toast"></div>
<div class="overlay hidden" id="askAdd">
  <div class="dialog">
    <div class="dialog-h" id="askTitle"></div>
    <p class="note" id="askText" style="margin:6px 0 0"></p>
    <div class="dialog-list" id="askList"></div>
    <button id="askYes" class="wide">含める</button>
    <button id="askNo" class="sub wide" style="margin-top:8px">含めない（これからの支払いだけ）</button>
    <button id="askCancel" class="linkbtn" style="display:block;margin:12px auto 0">追加をやめる</button>
  </div>
</div>

<script type="module">
// ===== Firebase の設定値（コンソールの firebaseConfig をここに貼る）=====
// null にすると「お試しモード」になり、このブラウザの中だけに保存します。
const firebaseConfig = {
  apiKey: "AIzaSyA6CsBv7aoHaI43DYLPpAuNn4IOkiVMcgw",
  authDomain: "trips-warikan.firebaseapp.com",
  projectId: "trips-warikan",
  storageBucket: "trips-warikan.firebasestorage.app",
  messagingSenderId: "670510838103",
  appId: "1:670510838103:web:110e53e7d0d86332780e12"
};
// =====================================================================

const FB_VER = '10.14.1';
const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const yen = n => (n < 0 ? '−' : '') + Math.abs(n).toLocaleString('ja-JP') + '円';
const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
const fmtDate = s => { const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s || ''); if (!m) return s || ''; const w = '日月火水木金土'[new Date(+m[1], m[2] - 1, +m[3]).getDay()]; return `${+m[2]}/${+m[3]}（${w}）`; };
function lsGet(k) { try { return localStorage.getItem(k); } catch { return null; } }
function lsSet(k, v) { try { localStorage.setItem(k, v); } catch {} }
function toast(msg) { const t = $('toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove('show'), 1800); }

// ----- 合言葉 -----
function getKey() {
  const k = new URLSearchParams(location.hash.slice(1)).get('k');
  return k && /^[0-9A-Za-z_-]{20,100}$/.test(k) ? k : null;
}
function newKey() {
  const abc = '0123456789abcdefghijklmnopqrstuvwxyz', a = new Uint32Array(24);
  crypto.getRandomValues(a);
  return Array.from(a, x => abc[x % abc.length]).join('');
}

// ----- 保存先（Firestore / お試しモード）-----
async function firestoreStore(key) {
  const app = await import(`https://www.gstatic.com/firebasejs/${FB_VER}/firebase-app.js`);
  const fs = await import(`https://www.gstatic.com/firebasejs/${FB_VER}/firebase-firestore.js`);
  const db = fs.getFirestore(app.initializeApp(firebaseConfig));
  const mCol = fs.collection(db, 'trips', key, 'members');
  const eCol = fs.collection(db, 'trips', key, 'expenses');
  const rCol = fs.collection(db, 'trips', key, 'receipts');
  const meta = fs.doc(db, 'trips', key);
  const delAll = async col => { const snap = await fs.getDocs(col); for (const d of snap.docs) await fs.deleteDoc(d.ref); };
  return {
    mode: 'firestore',
    subscribe(cb, onErr) {
      const state = { members: null, expenses: null };
      const emit = () => { if (state.members && state.expenses) cb(state.members, state.expenses); };
      fs.onSnapshot(mCol, s => { state.members = s.docs.map(d => ({ id: d.id, ...d.data() })); emit(); }, onErr);
      fs.onSnapshot(eCol, s => { state.expenses = s.docs.map(d => ({ id: d.id, ...d.data() })); emit(); }, onErr);
    },
    // 旅行名と状態（ルールが古いときは何もしない）
    subscribeMeta(cb) { fs.onSnapshot(meta, d => cb(d.exists() ? d.data() : null), err => console.warn('meta', err?.code)); },
    createMeta: name => fs.setDoc(meta, { name, status: 'active', createdAt: fs.serverTimestamp(), updatedAt: fs.serverTimestamp() }),
    updateMeta: d => fs.updateDoc(meta, { ...d, updatedAt: fs.serverTimestamp() }),
    // IDを先に決めて、保存の完了を待たずに画面へ反映できるようにする
    addMember: (name, order) => { const ref = fs.doc(mCol); return { id: ref.id, done: fs.setDoc(ref, { name, order, createdAt: fs.serverTimestamp() }) }; },
    deleteMember: id => fs.deleteDoc(fs.doc(mCol, id)),
    addExpense: async d => { const ref = fs.doc(eCol); await fs.setDoc(ref, { ...d, createdAt: fs.serverTimestamp(), updatedAt: fs.serverTimestamp() }); return ref.id; },
    updateExpense: (id, d) => fs.updateDoc(fs.doc(eCol, id), { ...d, updatedAt: fs.serverTimestamp() }),
    deleteExpense: id => fs.deleteDoc(fs.doc(eCol, id)),
    // レシート写真（支払いと同じIDで1枚ずつ）
    putReceipt: (id, data) => fs.setDoc(fs.doc(rCol, id), { data, createdAt: fs.serverTimestamp() }),
    getReceipt: async id => { const d = await fs.getDoc(fs.doc(rCol, id)); return d.exists() ? d.data().data : null; },
    deleteReceipt: id => fs.deleteDoc(fs.doc(rCol, id)),
    allReceipts: async () => (await fs.getDocs(rCol)).docs.map(d => ({ id: d.id, data: d.data().data })),
    deleteEverything: async () => { await delAll(rCol); await delAll(eCol); await delAll(mCol); try { await fs.deleteDoc(meta); } catch (err) { console.warn('meta', err?.code); } },
  };
}
function localStore(key) {
  const LK = 'warikan-demo-' + key;
  let cbs = [], mcbs = [];
  const load = () => { let s; try { s = JSON.parse(lsGet(LK)); } catch {} s = s || {}; return { members: s.members || {}, expenses: s.expenses || {}, receipts: s.receipts || {}, meta: s.meta || null }; };
  const emit = () => { const s = load(); const m = Object.entries(s.members).map(([id, v]) => ({ id, ...v })); const e = Object.entries(s.expenses).map(([id, v]) => ({ id, ...v })); cbs.forEach(cb => cb(m, e)); mcbs.forEach(cb => cb(s.meta || null)); };
  const mut = f => { const s = load(); f(s); lsSet(LK, JSON.stringify(s)); setTimeout(emit, 0); return Promise.resolve(); };
  const id = () => Math.random().toString(36).slice(2, 12);
  window.addEventListener('storage', e => { if (e.key === LK) emit(); });
  return {
    mode: 'local',
    subscribe(cb) { cbs.push(cb); emit(); },
    subscribeMeta(cb) { mcbs.push(cb); setTimeout(() => cb(load().meta || null), 0); },
    createMeta: name => mut(s => { s.meta = { name, status: 'active', createdAt: Date.now(), updatedAt: Date.now() }; }),
    updateMeta: d => mut(s => { s.meta = { ...s.meta, ...d, updatedAt: Date.now() }; }),
    addMember: (name, order) => { const k = id(); return { id: k, done: mut(s => { s.members[k] = { name, order, createdAt: Date.now() }; }) }; },
    deleteMember: mid => mut(s => { delete s.members[mid]; }),
    addExpense: d => { const k = id(); return mut(s => { s.expenses[k] = { ...d, createdAt: Date.now(), updatedAt: Date.now() }; }).then(() => k); },
    updateExpense: (eid, d) => mut(s => { s.expenses[eid] = { ...s.expenses[eid], ...d, updatedAt: Date.now() }; }),
    deleteExpense: eid => mut(s => { delete s.expenses[eid]; }),
    putReceipt: (eid, data) => mut(s => { s.receipts[eid] = { data }; }),
    getReceipt: async eid => load().receipts[eid]?.data ?? null,
    deleteReceipt: eid => mut(s => { delete s.receipts[eid]; }),
    allReceipts: async () => Object.entries(load().receipts).map(([id, v]) => ({ id, data: v.data })),
    deleteEverything: () => mut(s => { s.members = {}; s.expenses = {}; s.receipts = {}; s.meta = null; }),
  };
}

// ----- 計算 -----
// participants が ['__all__'] の支払いは「全員の分」。あとから追加したメンバーも含めて割る。
const ALL = '__all__';
const isAll = e => e.participants.includes(ALL);
const partsOf = e => isAll(e) ? members.map(m => m.id) : e.participants;
// 1人あたりの負担を1円単位で出す。割り切れない端数は、メンバー順で先の人から1円ずつ負担。
function shares(exp, order) {
  const parts = [...partsOf(exp)].sort((a, b) => (order[a] ?? 1e9) - (order[b] ?? 1e9));
  const n = parts.length, base = Math.floor(exp.amount / n), rem = exp.amount - base * n;
  const out = {};
  parts.forEach((p, i) => { out[p] = base + (i < rem ? 1 : 0); });
  return out;
}
function settle(members, expenses) {
  const order = Object.fromEntries(members.map((m, i) => [m.id, i]));
  const bal = Object.fromEntries(members.map(m => [m.id, { paid: 0, owe: 0 }]));
  for (const e of expenses) {
    if (!bal[e.payer] || !partsOf(e).length || !partsOf(e).every(p => bal[p])) continue;
    bal[e.payer].paid += e.amount;
    for (const [p, v] of Object.entries(shares(e, order))) bal[p].owe += v;
  }
  // 送金回数が少なくなるよう、一番多く受け取る人と一番多く払う人から順に組み合わせる
  const cred = [], debt = [];
  for (const m of members) { const d = bal[m.id].paid - bal[m.id].owe; if (d > 0) cred.push([m.id, d]); else if (d < 0) debt.push([m.id, -d]); }
  const transfers = [];
  while (cred.length && debt.length) {
    cred.sort((a, b) => b[1] - a[1]); debt.sort((a, b) => b[1] - a[1]);
    const c = cred[0], d = debt[0], x = Math.min(c[1], d[1]);
    transfers.push({ from: d[0], to: c[0], amount: x });
    c[1] -= x; d[1] -= x;
    if (!c[1]) cred.shift();
    if (!d[1]) debt.shift();
  }
  return { bal, transfers };
}

